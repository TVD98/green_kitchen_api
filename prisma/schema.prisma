// Prisma 7: connection URL lives in prisma.config.ts (not datasource url).
// moduleFormat cjs required for NestJS CommonJS runtime.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  email
  google
  facebook
}

enum OtpPurpose {
  password_reset
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?
  fullName         String?
  avatarUrl        String?
  provider         AuthProvider      @default(email)
  providerId       String?
  isLocked         Boolean           @default(false)
  failedLoginCount Int               @default(0)
  createdAt        DateTime          @default(now())
  refreshTokens    RefreshToken[]
  preferences      UserPreferences?
  allergies        UserAllergy[]
  discoveryQueries DiscoveryQuery[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  deviceId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId, deviceId])
}

model OtpSession {
  id             String     @id @default(cuid())
  email          String
  otpHash        String
  purpose        OtpPurpose
  attempts       Int        @default(0)
  expiresAt      DateTime
  resetTokenHash String?
  consumedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([email])
}

model Ingredient {
  id            String        @id @default(cuid())
  canonicalName String        @unique
  nameEn        String
  category      String
  aliasesVi     String[]      @default([])
  aliasesEn     String[]      @default([])
  allergies     UserAllergy[]
}

model UserPreferences {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryStyle        String?
  spiceLevel          String?
  cuisinePreferences  String[] @default([])
  dislikedIngredients String[] @default([])
  healthGoals         String[] @default([])
  updatedAt           DateTime @updatedAt
}

model UserAllergy {
  userId       String
  ingredientId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, ingredientId])
}

model Recipe {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  timeMinutes  Int
  difficulty   String
  servings     Int
  tags         String[]
  steps        Json
  ingredients  Json
  nutrition    Json?
  source       String   @default("gemini")
  createdAt    DateTime @default(now())

  @@index([title])
}

model PantryQuery {
  id              String   @id @default(cuid())
  userId          String?
  ingredientHash  String   @unique
  ingredientIds   String[]
  resultRecipeIds String[]
  createdAt       DateTime @default(now())
}

model DiscoveryQuery {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  promptHash      String   @unique
  prompt          String
  options         Json
  filters         Json?
  resultRecipeIds String[]
  createdAt       DateTime @default(now())
}
